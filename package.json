{
  "name": "sibyl-workspace",
  "version": "2.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "docs"
  ],
  "scripts": {
    "dev": "npm run dev --workspace frontend",
    "build": "npm run build --workspace frontend",
    "typecheck": "npm run typecheck --workspace frontend",
    "docs:dev": "npm run start --workspace docs -- --host 127.0.0.1",
    "docs:build": "npm run build --workspace docs",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "prettier": "^3.9.10"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0"
  }
}
