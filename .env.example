# Copy to .env. All settings also accept environment variables.
SIBYL_HOST=127.0.0.1
SIBYL_PORT=8000
SIBYL_DATA_DIR=.sibyl
# Legacy standalone research default: demo or live. This never activates accounts.
# Market prices default to Binance independently. Choose Demo prices in Settings for offline data.
SIBYL_MODE=demo
# News default: auto follows SIBYL_MODE; demo/live can be chosen independently.
SIBYL_NEWS_MODE=auto
SIBYL_NEWS_REFRESH_SECONDS=600
SIBYL_NEWS_RETENTION_DAYS=30
SIBYL_MARKET_EXCHANGE=binance
SIBYL_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Required when binding to a non-loopback address. Enter this in Settings in the UI.
SIBYL_API_TOKEN=
# Optional exchange market orders. Requires a trade-enabled key and UI confirmation.
SIBYL_ALLOW_LIVE_TRADING=false
# none gives factual tool snapshots without a language model.
# Or choose any ProtoLink provider in Settings → AI models.
# Saved workspace profiles override these environment defaults.
SIBYL_LLM_PROVIDER=none
SIBYL_LLM_MODEL=
SIBYL_LLM_BASE_URL=http://127.0.0.1:11434
# Save provider keys in Settings, or supply these variables to the API process.
# Install the corresponding optional extra for hosted SDKs.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# DEEPSEEK_API_KEY=
# XAI_API_KEY=
# HF_API_TOKEN=
# OPENAI_COMPATIBLE_API_KEY=
# OLLAMA_API_KEY=
# LMSTUDIO_API_KEY=
# VLLM_API_KEY=
